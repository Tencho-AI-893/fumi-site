# このファイルを「.env」という名前でコピーして、値を入れる。 .env は絶対にGitHubへ上げない（.gitignoreで除外済み）
NOTION_TOKEN=
NOTION_DATABASE_ID=
# 機微メモ専用のDB（任意）。空なら機微メモはPC内で保留される
NOTION_SENSITIVE_DATABASE_ID=
# AI: openai（既定）か ollama（店内ローカルAI）
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# この値より自信が低いと「要確認」になる（0〜1）
CONFIDENCE_THRESHOLD=0.6
